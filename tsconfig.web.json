{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "erasableSyntaxOnly": false
  },
  "include": [
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
