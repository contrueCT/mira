{
  "@mira/server": {
    "path": "apps/server",
    "allow": [
      "@mira/cognition",
      "@mira/context",
      "@mira/life",
      "@mira/persistence",
      "@mira/runtime-pi",
      "@mira/workspace",
      "@mira/extension-host",
      "@mira/external-sdk"
    ],
    "external": [
      "@earendil-works/pi-agent-core",
      "@earendil-works/pi-ai",
      "@earendil-works/pi-coding-agent",
      "fastify",
      "@fastify/static",
      "node-pty"
    ]
  },
  "@mira/web": {
    "path": "apps/web",
    "allow": [],
    "external": [
      "react",
      "react-dom",
      "@types/react",
      "@types/react-dom",
      "vite",
      "qrcode-generator"
    ]
  },
  "@mira/cognition": {
    "path": "packages/cognition",
    "allow": [],
    "external": []
  },
  "@mira/extension-host": {
    "path": "packages/extension-host",
    "allow": [
      "@mira/extension-sdk"
    ],
    "external": [
      "cordis",
      "@cordisjs/plugin-loader",
      "@cordisjs/plugin-hmr",
      "@cordisjs/plugin-timer"
    ]
  },
  "@mira/external-sdk": {
    "path": "packages/external-sdk",
    "allow": [],
    "external": []
  },
  "@mira/runtime-pi": {
    "path": "packages/runtime-pi",
    "allow": [
      "@mira/context",
      "@mira/life",
      "@mira/cognition"
    ],
    "external": [
      "@earendil-works/pi-agent-core",
      "@earendil-works/pi-ai",
      "@earendil-works/pi-coding-agent"
    ]
  },
  "@mira/extension-sdk": {
    "path": "packages/extension-sdk",
    "allow": [],
    "external": []
  },
  "@mira/workspace": {
    "path": "packages/workspace",
    "allow": [],
    "external": []
  },
  "@mira/life": {
    "path": "packages/life",
    "allow": [
      "@mira/context",
      "@mira/cognition"
    ],
    "external": []
  },
  "@mira/context": {
    "path": "packages/context",
    "allow": [],
    "external": []
  },
  "@mira/authorization": {
    "path": "packages/authorization",
    "allow": [],
    "external": []
  },
  "@mira/persistence": {
    "path": "packages/persistence",
    "allow": [
      "@mira/context",
      "@mira/life"
    ],
    "external": [
      "pg",
      "node-pg-migrate",
      "@types/pg"
    ]
  }
}
