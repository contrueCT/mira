{
  "compilerOptions": {
    "target": "ES2024",
    "jsx": "preserve",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*.mts",
    "tests/*.mts",
    "tests/foundation/**/*.mts",
    "tests/integration/**/*.mts",
    "tests/unit/**/*.mts",
    "apps/**/*.ts",
    "apps/**/*.mts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.mts",
    "packages/**/*.tsx",
    "examples/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/runtime-pi",
    "tests/unit/runtime.test.mts",
    "apps/server",
    "tests/unit/wake-runtime.test.mts",
    "tests/unit/server-demo.test.mts",
    "tests/unit/live-tools.test.mts",
    "packages/extension-host",
    "tests/unit/extension-host.test.mts",
    "tests/unit/extension-configuration.test.mts",
    "tests/unit/extension-runtime.test.mts",
    "tests/unit/extension-artifacts.test.mts",
    "tests/unit/generated-extensions.test.mts",
    "tests/unit/generated-runtime.test.mts",
    "tests/unit/system-prompt.test.mts",
    "tests/unit/skills.test.mts",
    "tests/unit/model-connections.test.mts",
    "tests/unit/model-tool-names.test.mts",
    "tests/unit/model-discovery.test.mts",
    "apps/web",
    "tests/unit/web-http.test.mts",
    "tests/unit/web-settings.test.mts",
    "tests/unit/web-service.test.mts",
    "tests/unit/web-extension-startup.test.mts",
    "scripts/tool-usability.mts",
    "tests/unit/tool-guidance.test.mts",
    "tests/unit/tool-diagnostics.test.mts",
    "tests/unit/extension-result-contract.test.mts",
    "tests/unit/auto-compaction.test.mts",
    "tests/unit/memory-checkpoint.test.mts",
    "tests/unit/compaction-continuity.test.mts",
    "tests/unit/external-http.test.mts",
    "scripts/external-sdk-usability.mts",
    "tests/unit/external-access.test.mts",
    "tests/unit/management.test.mts",
    "tests/unit/context-providers.test.mts"
  ]
}
