{
  "name": "mira",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm boundaries && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pi.json && tsc --noEmit -p tsconfig.extensions.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "boundaries": "node scripts/check-boundaries.mts",
    "test": "node scripts/run-tests.mts && pnpm --filter @mira/web test",
    "build": "tsc -p tsconfig.tools.json && pnpm --filter @mira/web build",
    "test:integration": "node scripts/run-tests.mts --integration",
    "check:all": "pnpm check && pnpm test:integration",
    "demo": "node apps/server/src/cli.mts",
    "models": "node apps/server/src/models-cli.mts",
    "start": "pnpm --filter @mira/web build && node apps/server/src/web-cli.mts",
    "test:e2e": "node scripts/run-web-tests.mts",
    "external-access": "node apps/server/src/external-access-cli.mts",
    "test:external:e2e": "node scripts/run-real-web-tests.mts external",
    "test:management:e2e": "node scripts/run-real-web-tests.mts management",
    "test:persona:e2e": "node scripts/run-real-web-tests.mts persona",
    "test:attachments:e2e": "node scripts/run-real-web-tests.mts attachments",
    "test:live-input:e2e": "node scripts/run-real-web-tests.mts live-input",
    "test:capabilities:e2e": "node scripts/run-real-web-tests.mts agent-capabilities",
    "test:feishu:e2e": "node scripts/run-real-web-tests.mts feishu",
    "test:auth:e2e": "node scripts/run-real-web-tests.mts auth",
    "terminal:prepare": "node scripts/prepare-terminal.mts",
    "test:mcp:e2e": "node scripts/run-real-web-tests.mts mcp",

    "test:pagination:e2e": "node scripts/run-real-web-tests.mts pagination",
    "test:replies:e2e": "node scripts/run-real-web-tests.mts replies",
    "test:browser:e2e": "node scripts/run-real-web-tests.mts browser"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "@mira/context": "workspace:*",
    "@mira/life": "workspace:*",
    "@mira/persistence": "workspace:*",
    "@mira/runtime-pi": "workspace:*",
    "pg": "8.23.1",
    "@types/pg": "8.23.1",
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@mira/cognition": "workspace:*",
    "@mira/workspace": "workspace:*",
    "@mira/server": "workspace:*",
    "@mira/extension-sdk": "workspace:*",
    "@mira/extension-host": "workspace:*",
    "@playwright/test": "1.63.0",
    "@mira/external-sdk": "workspace:*",
    "node-gyp": "11.4.2",
    "@modelcontextprotocol/server": "2.3.1"
  }
}
